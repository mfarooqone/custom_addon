<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_api_documentation" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.api.documentation</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="API Documentation"
                     string="API Documentation"
                     name="api_documentation"
                     logo="/api_documentation/static/description/icon.png"
                     groups="base.group_system">
                    <block title="API Documentation" name="api_documentation_setting">
                        <setting id="api_doc_open_page"
                                 string="REST API Reference"
                                 help="Open the shared API documentation page for all custom integrations.">
                            <button type="action"
                                    name="%(api_documentation.action_api_documentation)d"
                                    string="Open API Documentation"
                                    class="btn-link"
                                    icon="oi-arrow-right"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
