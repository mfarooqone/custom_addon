<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="api_doc_page" name="API Documentation">
        <html>
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <title>API Documentation</title>
                <link rel="stylesheet" href="/api_documentation/static/src/css/api_doc.css"/>
            </head>
            <body class="o_api_doc">
                <div class="o_api_doc_container">
                    <header class="o_api_doc_header">
                        <div>
                            <p class="o_api_doc_eyebrow">Najoom Al Thuraya · Odoo 19</p>
                            <h1>API Documentation</h1>
                            <p class="o_api_doc_lead">
                                REST API reference for external integrations. Each module adds its own section below.
                            </p>
                        </div>
                        <div class="o_api_doc_base_url">
                            <span>Base URL</span>
                            <code t-out="base_url"/>
                        </div>
                    </header>

                    <div class="o_api_doc_layout">
                        <aside class="o_api_doc_sidebar">
                            <nav class="o_api_doc_nav">
                                <p class="o_api_doc_nav_title">Contents</p>
                                <a href="#overview" class="o_api_doc_nav_item">Overview</a>
                                <!-- Other modules append links here via xpath -->
                                <div id="api_doc_nav"/>
                            </nav>
                        </aside>

                        <main class="o_api_doc_main">
                            <section id="overview" class="o_api_doc_section">
                                <h2>Overview</h2>
                                <p>All custom REST APIs use <code>application/json</code> for request and response bodies.</p>
                                <p>Successful responses follow this shape:</p>
                                <pre>{
  "success": true,
  "data": { }
}</pre>
                                <p>Error responses follow this shape:</p>
                                <pre>{
  "success": false,
  "error": "Error message here"
}</pre>
                                <p>Authentication details are documented in each API section below.</p>
                            </section>

                            <!-- Other modules append API sections here via xpath -->
                            <div id="api_doc_content"/>
                        </main>
                    </div>
                </div>
            </body>
        </html>
    </template>

    <record id="action_api_documentation" model="ir.actions.act_url">
        <field name="name">API Documentation</field>
        <field name="url">/api/docs</field>
        <field name="target">new</field>
    </record>

</odoo>
