<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_inherit_crm_integration" model="ir.ui.view">
        <field name="name">res.company.form.inherit.crm.integration</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="CRM Integration" name="crm_integration">
                    <group>
                        <field name="is_crm_integration_enabled"/>
                        <field name="crm_api_key" widget="password"/>
                    </group>
                    <div class="mt-2">
                        <button type="action"
                                name="%(crm_integration.action_crm_api_doc)d"
                                string="Open API Documentation"
                                class="btn-link"
                                icon="oi-arrow-right"/>
                    </div>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
