<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.module.category" id="module_category_college_erp">
        <field name="name">College ERP</field>
        <field name="sequence">50</field>
    </record>

    <record model="res.groups.privilege" id="res_groups_privilege_college_erp">
        <field name="name">College ERP</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="module_category_college_erp"/>
    </record>

    <record id="group_college_erp_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_college_erp"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Can view, create, and edit student records.</field>
    </record>

    <record id="group_college_erp_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_college_erp"/>
        <field name="implied_ids" eval="[(4, ref('group_college_erp_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Full access to College ERP, including deleting students.</field>
    </record>
</odoo>
