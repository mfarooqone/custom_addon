<?xml version="1.0" encoding="utf-8"?>
<odoo>

   <!-- Leave sequences alone on upgrade — resetting them was giving duplicate IDs -->
   <data noupdate="1">
   <record id="seq_customer" model="ir.sequence">
      <field name="name">Customer ID</field>
      <field name="code">customer.id</field>
      <field name="prefix">CUST</field>
      <field name="padding">5</field>
      <field name="number_next">1</field>
      <field name="number_increment">1</field>
   </record>

   <record id="seq_vendor" model="ir.sequence">
      <field name="name">Vendor ID</field>
      <field name="code">vendor.id</field>
      <field name="prefix">VEND</field>
      <field name="padding">5</field>
      <field name="number_next">1</field>
      <field name="number_increment">1</field>
   </record>

   <record id="seq_employee" model="ir.sequence">
      <field name="name">Employee ID</field>
      <field name="code">employee.id</field>
      <field name="prefix">EMP</field>
      <field name="padding">5</field>
      <field name="number_increment">1</field>
      <field name="number_next">1</field>
   </record>

   </data>

</odoo>
