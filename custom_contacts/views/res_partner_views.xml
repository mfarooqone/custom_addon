<?xml version="1.0" encoding="utf-8"?>
<odoo>

   <!-- Contact views — type, auto ID, filters -->

   <!-- Kanban -->
   <record id="view_partner_kanban_inherit_contact_type" model="ir.ui.view">
      <field name="name">res.partner.kanban.inherit.contact.type</field>
      <field name="model">res.partner</field>
      <field name="inherit_id" ref="base.res_partner_kanban_view" />
      <field name="arch" type="xml">
         <xpath expr="//kanban/field[@name='active']" position="after">
            <field name="is_internal_company" />
            <field name="contact_type" />
            <field name="contact_code" />
            <field name="customer_id" />
            <field name="vendor_id" />
         </xpath>
         <xpath expr="//field[@name='display_name']/parent::div" position="after">
            <div t-if="!record.is_internal_company.raw_value" class="mb-1">
               <field name="contact_type" widget="badge" />
            </div>
            <!-- Contacts app -->
            <div t-if="record.contact_code.raw_value" class="text-truncate mb-1"
               invisible="context.get('res_partner_search_mode') in ('customer', 'supplier')">
               <i class="fa fa-fw me-1 fa-id-card text-primary" title="ID" />
               <field name="contact_code" />
            </div>
            <!-- Sales → Customers -->
            <div t-if="record.customer_id.raw_value" class="text-truncate mb-1"
               invisible="context.get('res_partner_search_mode') != 'customer'">
               <i class="fa fa-fw me-1 fa-id-card text-primary" title="Customer ID" />
               <field name="customer_id" />
            </div>
            <!-- Purchase → Vendors -->
            <div t-if="record.vendor_id.raw_value" class="text-truncate mb-1"
               invisible="context.get('res_partner_search_mode') != 'supplier'">
               <i class="fa fa-fw me-1 fa-id-card text-primary" title="Vendor ID" />
               <field name="vendor_id" />
            </div>
         </xpath>
      </field>
   </record>

   <!-- List -->
   <record id="view_partner_tree_inherit_contact_type" model="ir.ui.view">
      <field name="name">res.partner.list.inherit.contact.type</field>
      <field name="model">res.partner</field>
      <field name="inherit_id" ref="base.view_partner_tree" />
      <field name="arch" type="xml">
         <xpath expr="//field[@name='display_name']" position="after">
            <field name="contact_code" string="ID" optional="show"
               column_invisible="context.get('res_partner_search_mode') in ('customer', 'supplier')" />
            <field name="customer_id" string="Customer ID" optional="show"
               column_invisible="context.get('res_partner_search_mode') != 'customer'" />
            <field name="vendor_id" string="Vendor ID" optional="show"
               column_invisible="context.get('res_partner_search_mode') != 'supplier'" />
         </xpath>
         <xpath expr="//field[@name='phone']" position="after">
            <field name="is_internal_company" column_invisible="1" />
            <field name="contact_type" optional="show" invisible="is_internal_company" />
         </xpath>
      </field>
   </record>

   <!-- Form -->
   <record id="view_partner_form_inherit_contact_type" model="ir.ui.view">
      <field name="name">res.partner.form.inherit.contact.type</field>
      <field name="model">res.partner</field>
      <field name="inherit_id" ref="base.view_partner_form" />
      <field name="arch" type="xml">
         <xpath expr="//field[@name='category_id']" position="after">
            <field name="is_internal_company" invisible="1" />
            <field name="contact_type"
               placeholder="Select contact type..."
               invisible="is_internal_company or context.get('res_partner_search_mode') in ('customer', 'supplier')"
               required="not is_internal_company"
               readonly="context.get('default_contact_type') == 'employee'" />
            <field name="customer_id" invisible="contact_type != 'customer' or is_internal_company" />
            <field name="vendor_id" invisible="contact_type != 'vendor'" />
            <field name="employee_id" invisible="contact_type != 'employee'" />
         </xpath>
      </field>
   </record>

   <!-- Search filters -->
   <record id="view_res_partner_filter_inherit_contact_type" model="ir.ui.view">
      <field name="name">res.partner.search.inherit.contact.type</field>
      <field name="model">res.partner</field>
      <field name="inherit_id" ref="base.view_res_partner_filter" />
      <field name="arch" type="xml">
         <xpath expr="//filter[@name='customer']" position="replace" />
         <xpath expr="//filter[@name='supplier']" position="replace" />
         <xpath expr="//filter[@name='type_company']" position="after">
            <separator />
            <filter string="Customers" name="contact_type_customer"
               domain="[('contact_type', '=', 'customer')]" />
            <filter string="Vendors" name="contact_type_vendor"
               domain="[('contact_type', '=', 'vendor')]" />
            <filter string="Employees" name="contact_type_employee"
               domain="[('contact_type', '=', 'employee')]" />
         </xpath>
         <xpath expr="//filter[@name='group_country']" position="after">
            <filter string="Contact Type" name="group_contact_type"
               context="{'group_by': 'contact_type'}" />
         </xpath>
      </field>
   </record>

   <!-- Sales → customers only, Purchase → vendors only -->
   <record id="account.res_partner_action_customer" model="ir.actions.act_window">
      <field name="domain">[('contact_type', '=', 'customer'), ('is_internal_company', '=', False)]</field>
      <field name="context"
         eval="{
            'res_partner_search_mode': 'customer',
            'default_is_company': True,
            'default_contact_type': 'customer',
        }" />
   </record>

   <record id="account.res_partner_action_supplier" model="ir.actions.act_window">
      <field name="domain">[('contact_type', '=', 'vendor'), ('is_internal_company', '=', False)]</field>
      <field name="context"
         eval="{
            'res_partner_search_mode': 'supplier',
            'default_is_company': True,
            'default_contact_type': 'vendor',
        }" />
   </record>

</odoo>
