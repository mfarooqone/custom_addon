<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_inherit_custom_invoice" model="ir.ui.view">
        <field name="name">res.company.form.inherit.custom.invoice</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Invoice Customization" name="report_images">
                    <group>
                        <field name="is_invoice_customization_enabled" />
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
